<?xml version="1.0" encoding="UTF-8"?>
<!--
  Maven settings for builds that must fetch common-lib and the db-* jars from GitHub Packages: the Docker build and CI
  (mvnw -s .mvn/github-settings.xml ...). A plain local build does not need it: the libraries come from ~/.m2 after a
  `mvn install` in their repos.

  Environment: GITHUB_ACTOR and GITHUB_TOKEN (a token with read:packages, or the workflow's GITHUB_TOKEN), and
  LIBS_REPO_URL (https://maven.pkg.github.com/GDB-11/* for every repo of the owner).
  Central is declared first on purpose: Maven asks repositories in order and stops at the first that has the artifact, so
  Spring and every other dependency come from Central and only com.sprintmodus falls through to GitHub Packages (a
  registry that answers 401 to a bad token would otherwise break every lookup).
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
	<servers>
		<server>
			<id>github</id>
			<username>${env.GITHUB_ACTOR}</username>
			<password>${env.GITHUB_TOKEN}</password>
		</server>
	</servers>
	<profiles>
		<profile>
			<id>sprintmodus-libs</id>
			<repositories>
				<repository>
					<id>central</id>
					<url>https://repo.maven.apache.org/maven2</url>
					<releases><enabled>true</enabled></releases>
					<snapshots><enabled>false</enabled></snapshots>
				</repository>
				<repository>
					<id>github</id>
					<url>${env.LIBS_REPO_URL}</url>
					<releases><enabled>true</enabled></releases>
					<snapshots><enabled>false</enabled></snapshots>
				</repository>
			</repositories>
		</profile>
	</profiles>
	<activeProfiles>
		<activeProfile>sprintmodus-libs</activeProfile>
	</activeProfiles>
</settings>
